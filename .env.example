# 环境配置示例文件
# 复制此文件为 .env 并填入实际配置；真实密钥不得提交到 Git

# ========================================
# 基础配置
# ========================================
# 环境类型 (development | production)
NODE_ENV=development

# 服务端口
PORT=3002

# ========================================
# SQLite 数据库配置
# ========================================
DATABASE_PATH=data/app.db
DATABASE_LOGGING=false

# ========================================
# Redis 配置 (可选,用于 Bull 队列)
# ========================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ========================================
# CORS 配置
# ========================================
# 允许的跨域来源，生产环境请修改为实际域名
CORS_ORIGIN=*

# ========================================
# 日志配置
# ========================================
# 日志级别 (debug | info | warn | error)
LOG_LEVEL=info

# ========================================
# 认证配置
# ========================================
# 每个环境单独生成；同一生产集群的所有实例必须保持一致
JWT_SECRET=

# 兼容旧管理端；迁移为仅使用管理员 JWT 后可删除
ADMIN_API_KEY=

# ========================================
# 微信服务号（占位配置；默认不调用微信）
# ========================================
# 微信小程序 AppID，用于服务号卡片跳转；已有部署继续使用其原 WX_APPID
WX_APPID=REPLACE_WITH_MINIPROGRAM_APPID
OA_APPID=REPLACE_WITH_OFFICIAL_ACCOUNT_APPID
OA_SECRET=REPLACE_WITH_OFFICIAL_ACCOUNT_SECRET
# 先单独启用粉丝同步，确认 UnionID 关联后再启用发送
OA_SYNC_ENABLED=false
OA_ENABLED=false
# 同一数据库仅一个实例设 true；其他实例仍可写待发送消息
OA_WORKER_ENABLED=true
# 相对启动工作目录的路径，也可使用绝对路径；复制示例后替换模板 ID、关键词与长度
OA_TEMPLATES_FILE=config/wechat-oa-templates.example.json
