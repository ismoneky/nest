# 环境配置示例文件
# 复制此文件为 .env.development 或 .env.production 并填入实际配置

# ========================================
# 基础配置
# ========================================
# 环境类型 (development | production)
NODE_ENV=development

# 服务端口
PORT=3002

# ========================================
# SQLite 数据库配置
# ========================================
DATABASE_PATH=data/app.db
DATABASE_LOGGING=false

# ========================================
# Redis 配置 (可选,用于 Bull 队列)
# ========================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ========================================
# CORS 配置
# ========================================
# 允许的跨域来源，生产环境请修改为实际域名
CORS_ORIGIN=*

# ========================================
# 日志配置
# ========================================
# 日志级别 (debug | info | warn | error)
LOG_LEVEL=info
