# 环境配置示例文件
# 复制此文件为 .env.development 或 .env.production 并填入实际配置

# ========================================
# 基础配置
# ========================================
# 环境类型 (development | production)
NODE_ENV=development

# 服务端口
PORT=3002

# ========================================
# SQLite 数据库配置
# ========================================
DATABASE_PATH=data/app.db
DATABASE_LOGGING=false

# ========================================
# Redis 配置 (可选,用于 Bull 队列)
# ========================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ========================================
# CORS 配置
# ========================================
# 允许的跨域来源，生产环境请修改为实际域名
CORS_ORIGIN=*

# ========================================
# 管理端退款安全配置
# ========================================
# 管理员对已完成订单退款时使用的独立二级密码 bcrypt 哈希。
# 只配置哈希，不要在环境文件中保存明文密码。
ADMIN_REFUND_PASSWORD_HASH=

# ========================================
# 日志配置
# ========================================
# 日志级别 (debug | info | warn | error)
LOG_LEVEL=info
